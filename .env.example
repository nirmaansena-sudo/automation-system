# ─────────────────────────────────────────────────────────────────────────────
# Nirmaan Sena automation system — settings
# Copy to .env (start-windows.bat does this for you) and restart after changes.
# Lines starting with # are comments.
# ─────────────────────────────────────────────────────────────────────────────

# Web server
PORT=3000
# Public HTTPS address of this system (used in links sent on WhatsApp).
# Local testing: http://localhost:3000   Server: https://ops.yourdomain.com
PUBLIC_URL=http://localhost:3000
# Required for Docker/Caddy HTTPS only: hostname without https:// or a path.
# Also set PUBLIC_URL=https://<DOMAIN>, COOKIE_SECURE=true and point DNS here.
DOMAIN=
# Where the database, photos and backups are stored (default: ./data)
# DATA_DIR=./data
# Set to true when PUBLIC_URL is https (server)
COOKIE_SECURE=false

# ── WhatsApp ────────────────────────────────────────────────────────────────
# simulator = test on this PC, nothing is sent to real phones
# cloud     = Meta WhatsApp Cloud API (official)
# dialog360 = 360dialog (Cloud-API compatible provider)
WHATSAPP_PROVIDER=simulator
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App secret from Meta → App settings → Basic (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Any random text; paste the same value in Meta's webhook settings (auto-generated if empty)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0
# true if you use the same number in the WhatsApp Business app (coexistence)
WHATSAPP_COEXISTENCE=false
# 360dialog only
DIALOG360_API_KEY=

# ── AI understanding (optional; buttons + rules work without it) ───────────
# off | anthropic | openai | n8n
AI_MODE=off
AI_API_KEY=
# Required for direct anthropic/openai modes; explicitly choose your provider's model.
AI_MODEL=
# For OpenAI-compatible providers (Gemini, Groq, OpenRouter, Azure…): their base URL
AI_BASE_URL=

# ── n8n (optional visual automations) ───────────────────────────────────────
# Local: http://localhost:5678   Docker: http://n8n:5678
N8N_BASE_URL=
# internal = this backend runs the daily routines; n8n = n8n runs them (backend is the fallback)
ROUTINES_MODE=internal

# ── Secrets (auto-generated into data/secrets.json if left empty) ───────────
# On a server with Docker, set these explicitly so n8n gets the same values.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SESSION_SECRET=
AUTOMATION_API_KEY=
N8N_SHARED_SECRET=
WEBSITE_FORM_SECRET=

# Travel: H3 dispatch runs locally. No routing service is called unless configured.
# Self-hosted/approved OSRM base URL; leave blank for clearly labelled estimates.
OSRM_BASE_URL=
# The manager sets per-km reimbursement rates in Travel & dispatch, not here.

# Encrypted full backup: save this password separately (minimum 16 characters).
# When blank, a generated data/backup.key is used; download and store it separately.
BACKUP_PASSWORD=
# Optional independent disk or synced folder; must be mounted if using Docker.
BACKUP_OFFSITE_DIR=

# Reverse proxies whose X-Forwarded-For header is trusted: exact addresses or CIDR
# ranges, comma-separated. Empty means forwarded headers are ignored.
#   docker compose (Caddy): set automatically to 172.30.97.10
#   Cloudflare tunnel on this PC: 127.0.0.1
# If this is wrong, every visitor shares the proxy's address, so one person's wrong
# passwords could lock everyone out; the dashboard health panel warns about it.
TRUSTED_PROXY_IPS=
# Optional self-hosted whisper.cpp /inference URL. Disabled while blank.
TRANSCRIPTION_URL=
TRANSCRIPTION_TOKEN=
TRANSCRIPTION_DAILY_LIMIT=25
TRANSCRIPTION_TIMEOUT_MS=25000
AI_DAILY_LIMIT=200
